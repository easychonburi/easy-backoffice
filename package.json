{
  "name": "easy-backoffice-firebase",
  "private": true,
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test functions/test/*.test.cjs",
    "emulators": "firebase emulators:start --project demo-easy-backoffice",
    "test:integration": "firebase emulators:exec --project demo-easy-backoffice --only firestore,auth \"node --test functions/test/*.integration.cjs\""
  },
  "dependencies": {
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "esbuild-wasm": "0.25.12",
    "firebase-tools": "^14.0.0"
  }
}
